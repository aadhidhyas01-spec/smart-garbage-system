    </joint>

    <!-- ================= 6. ARTICULATED ROBOTIC MANIPULATOR ARM ================= -->
    <!-- (As shown in Diagram: "ROBOTIC ARM: WASTE PICKUP OBJECT GRASPING") -->
    
    <!-- Arm Pedestal Mount on Truck Deck Behind Cab -->
    <link name="arm_base">
      <kinematic>true</kinematic>
      <pose>0.98 0 0.77 0 0 0</pose>
      <visual name="pedestal_column">
        <pose>0 0 0.21 0 0 0</pose>
        <geometry><cylinder><radius>0.21</radius><length>0.42</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse></material>
      </visual>
      <visual name="turntable_plate">
        <pose>0 0 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.28</radius><length>0.0875</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
      </visual>
      <visual name="safety_ring">
        <pose>0 0 0.4375 0 0 0</pose>
        <geometry><cylinder><radius>0.2888</radius><length>0.0262</length></cylinder></geometry>
        <material><ambient>0.95 0.75 0.05 1</ambient><diffuse>1.0 0.8 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.21 0 0 0</pose>
        <geometry><cylinder><radius>0.28</radius><length>0.455</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="arm_base_joint" type="fixed">
      <parent>chassis</parent><child>arm_base</child>
    </joint>

    <!-- Link 1 (Yaw Rotation Turret) -->
    <link name="arm_link1">
      <kinematic>true</kinematic>
      <pose>0.98 0 1.295 0 0 0</pose>
      <visual name="turret_body">
        <geometry><cylinder><radius>0.21</radius><length>0.35</length></cylinder></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <visual name="turret_collar">
        <pose>0 0 -0.14 0 0 0</pose>
        <geometry><cylinder><radius>0.2275</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
    </link>
    <joint name="arm_joint1" type="revolute">
      <parent>arm_base</parent><child>arm_link1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.14159</lower><upper>3.14159</upper></limit></axis>
    </joint>

    <!-- Link 2 (Shoulder Pitch Boom) -->
    <link name="arm_link2">
      <kinematic>true</kinematic>
      <pose>0.98 0 2.03 0 0 0</pose>
      <visual name="shoulder_pivot_knuckle">
        <pose>0 0 -0.49 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.1575</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient></material>
      </visual>
      <visual name="boom_main">
        <geometry><box><size>0.1925 0.2275 0.98</size></box></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <!-- Hydraulic Lift Cylinder Visual -->
      <visual name="hydraulic_cylinder">
        <pose>0.1225 0 -0.0875 0 0 0</pose>
        <geometry><cylinder><radius>0.0385</radius><length>0.735</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
      <visual name="hydraulic_rod">
        <pose>0.1225 0 0.245 0 0 0</pose>
        <geometry><cylinder><radius>0.0245</radius><length>0.42</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.9 1</ambient><specular>1 1 1 1</specular></material>
      </visual>
    </link>
    <joint name="arm_joint2" type="revolute">
      <pose>0 0 -0.49 0 0 0</pose>
      <parent>arm_link1</parent><child>arm_link2</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1.8</lower><upper>1.8</upper></limit></axis>
    </joint>

    <!-- Link 3 (Elbow Pitch Forearm) -->
    <link name="arm_link3">
      <kinematic>true</kinematic>
      <pose>0.98 0 3.08 0 0 0</pose>
      <visual name="elbow_pivot_knuckle">
        <pose>0 0 -0.49 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.1313</radius><length>0.2625</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient></material>
      </visual>
      <visual name="forearm_main">
        <geometry><box><size>0.1575 0.1925 0.945</size></box></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
    </link>
    <joint name="arm_joint3" type="revolute">
      <pose>0 0 -0.49 0 0 0</pose>
      <parent>arm_link2</parent><child>arm_link3</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.2</lower><upper>2.2</upper></limit></axis>
    </joint>

    <!-- Link 4 (Forearm Roll Cuff) -->
    <link name="arm_link4">
      <kinematic>true</kinematic>
      <pose>0.98 0 3.745 0 0 0</pose>
      <visual name="wrist_roll_cuff">
        <geometry><cylinder><radius>0.0875</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient></material>
      </visual>
    </link>
    <joint name="arm_joint4" type="revolute">
