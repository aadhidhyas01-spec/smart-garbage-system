      <axis><xyz>0 1 0</xyz><limit><lower>-1.8</lower><upper>1.8</upper></limit></axis>
    </joint>

    <!-- Link 6 (End-Effector Wrist & Mechanical Claw Gripper) -->
    <link name="arm_link6">
      <kinematic>true</kinematic>
      <pose>0.98 0 4.41 0 0 0</pose>
      
      <!-- Tool Mounting Flange -->
      <visual name="gripper_flange">
        <pose>0 0 -0.0875 0 0 0</pose>
        <geometry><cylinder><radius>0.084</radius><length>0.0613</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient></material>
      </visual>

      <!-- Gripper Palm Body -->
      <visual name="gripper_palm">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.1925 0.2625 0.105</size></box></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- Left Articulated Gripper Finger -->
      <visual name="finger_left">
        <pose>0 0.1488 0.1313 0 0.25 0</pose>
        <geometry><box><size>0.056 0.042 0.2275</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
      <!-- Left High-Grip Rubber Friction Pad -->
      <visual name="finger_pad_left">
        <pose>0 0.126 0.1488 0 0.25 0</pose>
        <geometry><box><size>0.0438 0.014 0.1575</size></box></geometry>
        <material>
          <ambient>0.95 0.45 0.05 1</ambient>
          <diffuse>1.0 0.5 0.05 1</diffuse>
        </material>
      </visual>

      <!-- Right Articulated Gripper Finger -->
      <visual name="finger_right">
        <pose>0 -0.1488 0.1313 0 -0.25 0</pose>
        <geometry><box><size>0.056 0.042 0.2275</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
      <!-- Right High-Grip Rubber Friction Pad -->
      <visual name="finger_pad_right">
        <pose>0 -0.126 0.1488 0 -0.25 0</pose>
        <geometry><box><size>0.0438 0.014 0.1575</size></box></geometry>
        <material>
          <ambient>0.95 0.45 0.05 1</ambient>
          <diffuse>1.0 0.5 0.05 1</diffuse>
        </material>
      </visual>

      <!-- Center Claw Opposable Stabilizer Finger -->
      <visual name="finger_center">
        <pose>0.1138 0 0.1313 0.25 0 0</pose>
        <geometry><box><size>0.042 0.056 0.2275</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
      <visual name="finger_pad_center">
        <pose>0.0945 0 0.1488 0.25 0 0</pose>
        <geometry><box><size>0.014 0.0438 0.1575</size></box></geometry>
        <material>
          <ambient>0.95 0.45 0.05 1</ambient>
          <diffuse>1.0 0.5 0.05 1</diffuse>
        </material>
      </visual>

    </link>
    <joint name="arm_joint6" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>arm_link5</parent><child>arm_link6</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.14159</lower><upper>3.14159</upper></limit></axis>
    </joint>

