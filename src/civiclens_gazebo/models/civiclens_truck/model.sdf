          <ambient>0.75 0.75 0.80 1</ambient>
          <diffuse>0.90 0.90 0.95 1</diffuse>
          <specular>0.95 0.95 1.0 1</specular>
        </material>
      </visual>
      <!-- Crusher High-Torque Hydraulic Reduction Motor -->
      <visual name="crusher_drive_motor">
        <pose>-1.54 0.805 0.56 0 1.5707 1.5707</pose>
        <geometry><cylinder><radius>0.1313</radius><length>0.1575</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.20 0.20 0.25 1</diffuse></material>
      </visual>
      <!-- Crusher Side Warning Hazard Stripes (Yellow / Black) -->
      <visual name="crusher_hazard_plate_left">
        <pose>-1.54 0.7612 0.35 0 0 0</pose>
        <geometry><box><size>0.455 0.0088 0.14</size></box></geometry>
        <material>
          <ambient>0.95 0.75 0.05 1</ambient>
          <diffuse>1.0 0.8 0.1 1</diffuse>
          <emissive>0.3 0.2 0.02 1</emissive>
        </material>
      </visual>
      <visual name="crusher_hazard_plate_right">
        <pose>-1.54 -0.7612 0.35 0 0 0</pose>
        <geometry><box><size>0.455 0.0088 0.14</size></box></geometry>
        <material>
          <ambient>0.95 0.75 0.05 1</ambient>
          <diffuse>1.0 0.8 0.1 1</diffuse>
          <emissive>0.3 0.2 0.02 1</emissive>
        </material>
      </visual>

      <!-- ================= SOLID COLLISION BOUNDS ================= -->
      <collision name="collision">
        <geometry><box><size>4.025 1.715 1.3125</size></box></geometry>
      </collision>
    </link>

    <!-- ================= WHEELS (SPINNING KINEMATIC WHEELS) ================= -->
    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <kinematic>true</kinematic>
      <pose>1.19 0.945 0.315 -1.5707 0 0</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.385</radius><length>0.245</length></cylinder></geometry>
      </collision>
      <visual name="tire">
        <geometry><cylinder><radius>0.385</radius><length>0.245</length></cylinder></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="rim">
        <pose>0 0 0.0175 0 0 0</pose>
        <geometry><cylinder><radius>0.2275</radius><length>0.2537</length></cylinder></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="spoke_1">
        <pose>0 0 0.1225 0 0 0</pose>
        <geometry><box><size>0.385 0.0525 0.035</size></box></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient></material>
      </visual>
      <visual name="spoke_2">
        <pose>0 0 0.1225 0 0 1.5707</pose>
        <geometry><box><size>0.385 0.0525 0.035</size></box></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient></material>
      </visual>
      <visual name="hub">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry><cylinder><radius>0.0788</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient></material>
      </visual>
    </link>
    <joint name="fl_joint" type="revolute">
      <parent>chassis</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <kinematic>true</kinematic>
      <pose>1.19 -0.945 0.315 -1.5707 0 0</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.385</radius><length>0.245</length></cylinder></geometry>
      </collision>
      <visual name="tire">
        <geometry><cylinder><radius>0.385</radius><length>0.245</length></cylinder></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="rim">
