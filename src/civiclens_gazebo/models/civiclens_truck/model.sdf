        <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="spoke_1">
        <pose>0 0 -0.1225 0 0 0</pose>
        <geometry><box><size>0.385 0.0525 0.035</size></box></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient></material>
      </visual>
      <visual name="spoke_2">
        <pose>0 0 -0.1225 0 0 1.5707</pose>
        <geometry><box><size>0.385 0.0525 0.035</size></box></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient></material>
      </visual>
      <visual name="hub">
        <pose>0 0 -0.14 0 0 0</pose>
        <geometry><cylinder><radius>0.0788</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient></material>
      </visual>
    </link>
    <joint name="fr_joint" type="revolute">
      <parent>chassis</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Rear Left Wheel -->
    <link name="rear_left_wheel">
      <kinematic>true</kinematic>
      <pose>-1.19 0.945 0.315 -1.5707 0 0</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.385</radius><length>0.245</length></cylinder></geometry>
      </collision>
      <visual name="tire">
        <geometry><cylinder><radius>0.385</radius><length>0.245</length></cylinder></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="rim">
        <pose>0 0 0.0175 0 0 0</pose>
        <geometry><cylinder><radius>0.2275</radius><length>0.2537</length></cylinder></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="spoke_1">
        <pose>0 0 0.1225 0 0 0</pose>
        <geometry><box><size>0.385 0.0525 0.035</size></box></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient></material>
      </visual>
      <visual name="spoke_2">
        <pose>0 0 0.1225 0 0 1.5707</pose>
        <geometry><box><size>0.385 0.0525 0.035</size></box></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient></material>
      </visual>
      <visual name="hub">
