      <axis><xyz>0 0 1</xyz><limit><lower>-3.14159</lower><upper>3.14159</upper></limit></axis>
    </joint>

    <!-- Link 5 (Wrist Pitch Knuckle) -->
    <link name="arm_link5">
      <kinematic>true</kinematic>
      <pose>0.98 0 4.06 0 0 0</pose>
      <visual name="wrist_pitch_knuckle">
        <geometry><box><size>0.1313 0.1313 0.2625</size></box></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
