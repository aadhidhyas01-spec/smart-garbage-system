      </visual>
      <visual name="rim">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.13</radius><length>0.145</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.85 0.85 0.88 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient></material>
      </visual>
    </link>
    <joint name="rr_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ================= 6-DOF INDUSTRIAL ROBOTIC ARM ================= -->
    <!-- Arm Base Pedestal -->
    <link name="arm_base">
      <kinematic>true</kinematic>
      <pose>0.6 0 0.80 0 0 0</pose>
      <!-- Base Turntable Plate -->
      <visual name="turntable_plate">
        <geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry>
        <material>
          <ambient>0.18 0.18 0.20 1</ambient>
          <diffuse>0.22 0.22 0.25 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <!-- Turntable Yellow Safety Ring -->
      <visual name="safety_ring">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.182</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.18</radius><length>0.10</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="arm_base_joint" type="fixed">
      <parent>chassis</parent><child>arm_base</child>
    </joint>

    <!-- Link 1 (Yaw Rotation Turret) -->
    <link name="arm_link1">
      <kinematic>true</kinematic>
      <pose>0.6 0 0.96 0 0 0</pose>
      <!-- Sleek White Robotic Turret Body -->
      <visual name="turret_body">
        <geometry><cylinder><radius>0.13</radius><length>0.22</length></cylinder></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <!-- Black Actuator Collar -->
      <visual name="turret_collar">
        <pose>0 0 -0.09 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
    </link>
    <joint name="arm_joint1" type="revolute">
      <parent>arm_base</parent><child>arm_link1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit></axis>
    </joint>

    <!-- Link 2 (Shoulder Pitch Boom) -->
    <link name="arm_link2">
      <kinematic>true</kinematic>
      <pose>0.6 0 1.38 0 0 0</pose>
      <!-- Shoulder Joint Pivot Knuckle -->
      <visual name="shoulder_knuckle">
        <pose>0 0 -0.30 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient></material>
      </visual>
      <!-- Main Boom Arm (White) -->
      <visual name="boom_arm">
        <geometry><box><size>0.12 0.14 0.58</size></box></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <!-- Side Hydraulic / Cable Duct Accent -->
      <visual name="boom_accent">
        <pose>0.07 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
    </link>
    <joint name="arm_joint2" type="revolute">
      <pose>0 0 -0.3 0 0 0</pose>
      <parent>arm_link1</parent><child>arm_link2</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper></limit></axis>
    </joint>

    <!-- Link 3 (Elbow Pitch Forearm) -->
    <link name="arm_link3">
      <kinematic>true</kinematic>
      <pose>0.6 0 1.98 0 0 0</pose>
      <!-- Elbow Joint Pivot Knuckle -->
      <visual name="elbow_knuckle">
        <pose>0 0 -0.30 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient></material>
      </visual>
      <!-- Forearm Arm (White) -->
      <visual name="forearm">
        <geometry><box><size>0.10 0.12 0.56</size></box></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
    </link>
    <joint name="arm_joint3" type="revolute">
      <pose>0 0 -0.3 0 0 0</pose>
      <parent>arm_link2</parent><child>arm_link3</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.0</lower><upper>2.0</upper></limit></axis>
    </joint>

    <!-- Link 4 (Forearm Roll) -->
    <link name="arm_link4">
      <kinematic>true</kinematic>
      <pose>0.6 0 2.38 0 0 0</pose>
      <visual name="wrist_roll_cuff">
        <geometry><cylinder><radius>0.05</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient></material>
      </visual>
    </link>
    <joint name="arm_joint4" type="revolute">
      <pose>0 0 -0.1 0 0 0</pose>
      <parent>arm_link3</parent><child>arm_link4</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit></axis>
    </joint>

    <!-- Link 5 (Wrist Pitch Knuckle) -->
    <link name="arm_link5">
      <kinematic>true</kinematic>
      <pose>0.6 0 2.58 0 0 0</pose>
      <visual name="wrist_pitch_knuckle">
        <geometry><box><size>0.08 0.08 0.16</size></box></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="arm_joint5" type="revolute">
      <pose>0 0 -0.1 0 0 0</pose>
      <parent>arm_link4</parent><child>arm_link5</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper></limit></axis>
    </joint>

    <!-- Link 6 (End-Effector Wrist & Mechanical Gripper Claw) -->
    <link name="arm_link6">
      <kinematic>true</kinematic>
      <pose>0.6 0 2.78 0 0 0</pose>
      
      <!-- Tool Flange Mount Plate -->
      <visual name="gripper_flange">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient></material>
      </visual>

      <!-- Gripper Palm Body -->
      <visual name="gripper_palm">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry><box><size>0.12 0.16 0.06</size></box></geometry>
        <material>
          <ambient>0.94 0.94 0.96 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>

      <!-- Left Gripper Finger -->
      <visual name="finger_left">
        <pose>0 0.09 0.07 0 0.25 0</pose>
        <geometry><box><size>0.035 0.025 0.12</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
      <!-- Left Rubber Friction Pad -->
      <visual name="finger_pad_left">
        <pose>0 0.076 0.08 0 0.25 0</pose>
        <geometry><box><size>0.028 0.008 0.08</size></box></geometry>
        <material><ambient>0.9 0.5 0.1 1</ambient></material> <!-- Orange Grip Pad -->
      </visual>

      <!-- Right Gripper Finger -->
      <visual name="finger_right">
        <pose>0 -0.09 0.07 0 -0.25 0</pose>
        <geometry><box><size>0.035 0.025 0.12</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>
      <!-- Right Rubber Friction Pad -->
      <visual name="finger_pad_right">
        <pose>0 -0.076 0.08 0 -0.25 0</pose>
        <geometry><box><size>0.028 0.008 0.08</size></box></geometry>
        <material><ambient>0.9 0.5 0.1 1</ambient></material> <!-- Orange Grip Pad -->
      </visual>

      <!-- Center Claw Stabilizer Finger -->
      <visual name="finger_center">
        <pose>0.07 0 0.07 0.25 0 0</pose>
        <geometry><box><size>0.025 0.035 0.12</size></box></geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient></material>
      </visual>

    </link>
    <joint name="arm_joint6" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>arm_link5</parent><child>arm_link6</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit></axis>
    </joint>

    <plugin filename="libtruck_gazebo_plugin.so" name="civiclens::TruckGazeboPlugin">
    </plugin>
  </model>
</sdf>
