<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="waste">
    <link name="link">
      <kinematic>true</kinematic>
      <pose>0 0 0.2 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz></inertia>
      </inertial>

      <!-- Main Bulging Bag Body (Black Polythene) -->
      <visual name="bag_base">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.16</length></cylinder></geometry>
        <material>
          <ambient>0.06 0.06 0.07 1</ambient>
          <diffuse>0.10 0.10 0.12 1</diffuse>
          <specular>0.8 0.8 0.85 1</specular>
        </material>
      </visual>

      <visual name="bag_belly_center">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><sphere><radius>0.19</radius></sphere></geometry>
        <material>
          <ambient>0.06 0.06 0.07 1</ambient>
          <diffuse>0.10 0.10 0.12 1</diffuse>
          <specular>0.85 0.85 0.9 1</specular>
        </material>
      </visual>

      <!-- Side Bulges & Wrinkles (Organic Trash Bag Folds) -->
      <visual name="bag_fold_left">
        <pose>-0.05 0.04 0.0 0.2 -0.1 0.3</pose>
        <geometry><sphere><radius>0.15</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.09 0.09 0.11 1</diffuse>
          <specular>0.75 0.75 0.8 1</specular>
        </material>
      </visual>

      <visual name="bag_fold_right">
        <pose>0.06 -0.03 0.02 -0.15 0.2 -0.2</pose>
        <geometry><sphere><radius>0.15</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.09 0.09 0.11 1</diffuse>
          <specular>0.75 0.75 0.8 1</specular>
        </material>
      </visual>

      <!-- Upper Gathered Neck Folds -->
      <visual name="bag_neck_taper">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry><cylinder><radius>0.13</radius><length>0.1</length></cylinder></geometry>
        <material>
          <ambient>0.06 0.06 0.07 1</ambient>
          <diffuse>0.10 0.10 0.12 1</diffuse>
          <specular>0.8 0.8 0.85 1</specular>
        </material>
      </visual>

      <!-- Cinched Tight Tie Collar (Tie Band) -->
      <visual name="bag_tie_collar">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.8 0.7 0.1 1</ambient> <!-- Yellow trash bag tie-tape -->
          <diffuse>0.85 0.75 0.12 1</diffuse>
        </material>
      </visual>

      <!-- Tied Top Knot -->
      <visual name="bag_tied_knot">
        <pose>0 0 0.23 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material>
          <ambient>0.06 0.06 0.07 1</ambient>
          <diffuse>0.10 0.10 0.12 1</diffuse>
          <specular>0.8 0.8 0.85 1</specular>
        </material>
      </visual>

      <!-- Tied Bag Top Ears / Plastic Flaps -->
      <visual name="bag_ear_left">
        <pose>-0.03 0.02 0.27 0.3 -0.5 0.2</pose>
        <geometry><box><size>0.06 0.02 0.08</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.09 0.09 0.11 1</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>
      </visual>

      <visual name="bag_ear_right">
        <pose>0.03 -0.02 0.27 -0.3 0.5 -0.2</pose>
        <geometry><box><size>0.06 0.02 0.08</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.09 0.09 0.11 1</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>
      </visual>

      <!-- Collision Shape -->
      <collision name="collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.20</radius><length>0.38</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
